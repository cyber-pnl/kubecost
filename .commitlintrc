{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "build",
        "ci",
        "chore",
        "revert"
      ]
    ],
    "scope-enum": [
      2,
      "always",
      [
        "cluster",
        "kubecost",
        "teams",
        "scripts",
        "chargeback",
        "finops",
        "docs",
        "ci",
        "deps"
      ]
    ],
    "subject-case": [0],
    "header-max-length": [2, "always", 100],
    "body-leading-blank": [2, "always"],
    "footer-leading-blank": [2, "always"]
  },
  "helpUrl": "https://www.conventionalcommits.org/en/v1.0.0/"
}
